# Copy this file to `.env` and fill in your key:   cp .env.example .env
#
# FRED API key: free at https://fred.stlouisfed.org/docs/api/api_key.html
# Without a key the app falls back to FRED's public CSV download endpoint,
# which works but is slower and less reliable.
FRED_API_KEY=

# Hours before cached FRED data is considered stale and re-downloaded.
CACHE_MAX_AGE_HOURS=12
